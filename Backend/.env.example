# Copy to .env and fill in to activate the customer-support chatbot.
# Never commit the real .env file.
# --- Django security (optional; safe defaults for local dev) ---
# SECRET_KEY=change-me-to-a-long-random-string-in-production
# DJANGO_DEBUG=1
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://[::1]:5173,http://127.0.0.1:5173

FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
CHATBOT_API_KEY=sk-xxxxx
CHATBOT_API_BASE=https://openrouter.ai/api/v1
CHATBOT_MODEL=openai/gpt-4o-mini
CHATBOT_TIMEOUT=45
CHATBOT_MAX_TOKENS=600
CHATBOT_MAX_HISTORY=20
CHATBOT_RATE_PER_SESSION=40
CHATBOT_RATE_PER_IP=200

# Flutterwave (v4 — OAuth 2.0) — the only payment gateway.
# FLUTTERWAVE_CLIENT_ID + FLUTTERWAVE_CLIENT_SECRET are the v4 API credentials
# from the Flutterwave dashboard. FLUTTERWAVE_ENCRYPTION_KEY is unused by the
# hosted checkout flow (stored for completeness). FLUTTERWAVE_PUBLIC_KEY is the
# dashboard "Public Key" used by the browser Checkout SDK. FLUTTERWAVE_SECRET_HASH
# is the webhook secret hash (set it so webhook signatures are verified in production).
# FLUTTERWAVE_SANDBOX: 1 -> sandbox API, empty -> live API.
# NOTE: the webhook callback URL must be a PUBLIC https URL (see
# FLUTTERWAVE_CALLBACK_URL); Flutterwave servers cannot reach
# http://localhost. For local dev, the return-page verification handles
# activation.
FLUTTERWAVE_CLIENT_ID=your-v4-client-id
FLUTTERWAVE_CLIENT_SECRET=your-v4-client-secret
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key
FLUTTERWAVE_PUBLIC_KEY=your-public-key
FLUTTERWAVE_SECRET_HASH=your-webhook-secret-hash
FLUTTERWAVE_SANDBOX=1
FLUTTERWAVE_CALLBACK_URL=http://localhost:5173/api/payments/flutterwave-webhook/
